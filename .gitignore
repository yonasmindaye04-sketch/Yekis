node_modules/
dist/
apps/frontend/dist/
.aistudio/
bun.lock
.env
*.log
.DS_Store

# pnpm content-addressable store (.npmrc points store-dir here). This is a
# cache of downloaded tarballs and must never be tracked.
.pnpm-store/
apps/backend/src/**/*.js
apps/backend/src/**/*.d.ts
apps/backend/src/**/*.js.map

# User-uploaded runtime data (chat attachments, evidence files). Never commit.
apps/backend/uploads/

backups/
*.dump

# test run output
apps/backend/*report*.json

# ---- Batch 0.6: repository hygiene ----
# Reference material that is not part of the application: a vendored oauth4webapi
# library, an old copy of the starter backend, and business/legal .docx files.
# Nothing in apps/ or packages/ imports from it (verified: no import, no tsconfig
# path, no build script reference), so it is untracked. Files stay on disk.
resource_to_read/

# Microsoft Office lock files (~$...). Created when a .docx is open in Word and
# committed by accident.
~$*

# Scratch files produced by editors, installers and test runs.
*.tmp

# OWASP ZAP scan reports. The request/response evidence in these files can
# contain captured session cookies, bearer tokens and request bodies, so they
# stay local. Force-add a redacted report only if you want it in history.
docs/security/zap/*.xml
docs/security/zap/*.json
docs/security/zap/*.html
docs/security/zap/*.md

# One-off local scripts that embed real credentials. fix_env.js writes a
# TELEBIRR_PRIVATE_KEY into .env, so it must never be tracked.
apps/backend/fix_env.js
apps/backend/test-webhook.js
