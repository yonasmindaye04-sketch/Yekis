# Copy to .env and fill in. Never commit the real .env file.

NODE_ENV=development
PORT=4000

# Local dev matches docker-compose.yml exactly
DATABASE_URL=postgresql://marketplace:marketplace_dev_only@localhost:5433/marketplace

# Redis requires a password (see docker-compose.yml). Generate one with:
#   openssl rand -hex 24
# REDIS_PASSWORD is read by compose; the password is embedded in both URLs below
# so the application and the suite authenticate automatically.
REDIS_PASSWORD=replace_me_with_a_random_hex_string
REDIS_URL=redis://:replace_me_with_a_random_hex_string@localhost:6379

# ---------- TEST SUITE (Batch 0.6) ----------
# The backend tests MUST NOT run against DATABASE_URL. Several suites call
# deleteMany(), and one bug deleted every Milestone row in the dev database.
# The suite reads DATABASE_URL_TEST instead and refuses to start unless the
# database name contains "_test".
#
# The test database is created by infra/postgres/init-test-db.sql on first
# Postgres init. On an existing volume run this by hand:
#   docker exec yekis-postgres-1 psql -U marketplace -d marketplace \
#     -c "CREATE DATABASE marketplace_test;"
#
# REDIS_URL_TEST points at Redis logical database 1, not 0, so rate-limit keys
# written by tests cannot collide with dev-server keys (nor evict them).
DATABASE_URL_TEST=postgresql://marketplace:marketplace_dev_only@localhost:5433/marketplace_test
REDIS_URL_TEST=redis://:replace_me_with_a_random_hex_string@localhost:6379/1

# ---------- MinIO / S3 (docker-compose.yml) ----------
# Non-default credentials. `minioadmin` is public knowledge, so the defaults are
# not acceptable even for local development.
MINIO_ROOT_USER=replace_me_with_a_local_object_store_user
MINIO_ROOT_PASSWORD=replace_me_with_a_random_password_string

# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=replace_me_with_a_real_32plus_char_secret
JWT_REFRESH_SECRET=replace_me_with_a_different_32plus_char_secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# MinIO locally (matches docker-compose.yml); swap for the real Ethiopian-hosted
# S3-compatible endpoint in staging/production â€” see the infra discussion on
# data residency (PDPP Art. 22) before picking a provider.
OBJECT_STORE_ENDPOINT=http://localhost:9000
OBJECT_STORE_BUCKET=marketplace-dev
OBJECT_STORE_ACCESS_KEY=marketplace
OBJECT_STORE_SECRET_KEY=marketplace_dev_only

# Leave blank until you have real sandbox credentials from each provider
# (PAY-001/PAY-002: Telebirr + CBE are the approved rails; Chapa removed)
CBE_WEBHOOK_SECRET=

# ---------- Telebirr (PAY-001) ----------
# SANDBOX vs PRODUCTION
#
# Telebirr runs two separate, non-interchangeable environments. Their test
# gateway is the "developerportal" host, which is what this project defaulted
# to before TELEBIRR_ENV existed — so a production boot with no overrides
# pointed live traffic at the test gateway and every real top-up went nowhere.
#
#   TELEBIRR_ENV=sandbox      the developerportal test gateway. Local dev only.
#                             The two *_BASE_URL values below may be left unset
#                             and default to the sandbox addresses.
#   TELEBIRR_ENV=production   the live Telebirr gateway. BOTH *_BASE_URL values
#                             are REQUIRED and must be the real production
#                             addresses from Telebirr's onboarding documents.
#                             There is deliberately NO default here: guessing a
#                             live gateway would move real money. The app
#                             refuses to boot if either URL still contains the
#                             developerportal host while NODE_ENV=production.
#
# Set TELEBIRR_ENV=sandbox locally. Leave the *_BASE_URL lines commented in
# development so the sandbox default applies.
TELEBIRR_ENV=sandbox
# TELEBIRR_BASE_URL=https://developerportal.ethiotelebirr.et:38443/apiaccess/payment/gateway
# TELEBIRR_WEB_BASE_URL=https://developerportal.ethiotelebirr.et:38443/payment/web/paygate?

# Telebirr credentials. Required in production; blank until you have real ones.
# Note the app refuses to start if ANY of these are set without TELEBIRR_ENV,
# because an undeclared gateway is ambiguous.
TELEBIRR_FABRIC_APP_ID=
TELEBIRR_APP_SECRET=
TELEBIRR_MERCHANT_APP_ID=
TELEBIRR_MERCHANT_CODE=
# Per-rail checkout switches. Telebirr is connected, so it needs no flag. CBE
# Birr and M-Pesa have no approved merchant API; their clients always throw.
# They stay false so POST /wallet/topups/checkout answers
# 400 PROVIDER_NOT_AVAILABLE rather than implying a temporary outage.
# Flip one only when that integration is genuinely live.
CBE_BIRR_CHECKOUT_ENABLED=false
MPESA_CHECKOUT_ENABLED=false
# RSA PKCS#8 PEM, used to SIGN requests. Keep the newlines exactly as issued.
TELEBIRR_PRIVATE_KEY=
# Telebirr's RSA public key, used to VERIFY the settlement webhook. Required in
# production: without it a settlement cannot be attributed to a genuine provider.
TELEBIRR_PUBLIC_KEY=
# Optional overrides. Leave unset to let notify_url be built from
# API_PUBLIC_URL and redirect_url from FRONTEND_URL.
TELEBIRR_NOTIFY_URL=
TELEBIRR_REDIRECT_URL=
TELEBIRR_TIMEOUT_EXPRESS=120m

# Kill switch for POST /api/v1/webhooks/cbe. Default false: the route answers
# 404 while this is off, so an unauthenticated-by-design money endpoint has to
# be switched on deliberately.
#
# The app refuses to boot in production on EITHER contradiction, because both
# are silent money holes:
#   secret set + flag off -> provider believes the endpoint is live, retries,
#                            and every CBE top-up stays pending forever
#   flag on + no secret   -> the route cannot verify anything
CBE_WEBHOOK_ENABLED=false

# SECURITY: mock top-up auto-approval. Dev-only convenience for settling
# Telebirr sandbox top-ups without receipts. Defaults OFF; ignored entirely
# when NODE_ENV=production. CBE Birr / M-Pesa top-ups are NEVER auto-approved
# regardless of this flag â€” they require a verified webhook or staff approval.
ALLOW_MOCK_PAYMENT_AUTO_APPROVAL=false

# Telegram Bot
# Get from @BotFather
TELEGRAM_BOT_TOKEN=
# Production only. Must match the route exactly: the bot router is mounted at
# /api/v1/telegram, so the webhook is POST /api/v1/telegram/webhook.
# Leave blank in development â€” the bot long-polls instead.
TELEGRAM_WEBHOOK_URL=https://your-domain.com/api/v1/telegram/webhook
TELEGRAM_WEBHOOK_SECRET=generate-with-openssl-rand-base64-32

# Bot handle WITHOUT the leading @ (e.g. ye_kis_bot). Served to the frontend so
# the Login Widget and "Open in Telegram" deep link always target the deployed
# bot instead of a handle hardcoded in the client.
#
# IMPORTANT for the browser Login Widget: the site domain must also be
# registered with @BotFather using /setdomain, otherwise the widget renders
# nothing. That is why the sign-in page also accepts a one-time code sent by
# the bot (/login) â€” a path that needs no domain registration at all.
TELEGRAM_BOT_USERNAME=

# Replay window for a signed Telegram credential (Mini App initData / Login
# Widget payload). A captured string is a bearer credential, so keep this short.
# Default 900 (15 minutes). Also accepts "0"? No - must be a positive integer.
TELEGRAM_INIT_DATA_MAX_AGE_SECONDS=900

# ── Telegram environment (hardening T0.2) ──────────────────────────────────
# Which Telegram environment this process talks to: dev | staging | prod.
# SEPARATE from NODE_ENV on purpose. The most damaging misconfiguration
# available here is running the production bot token against a locally modified
# build, which makes local code the authority for real members' money and KYC
# decisions.
#
# Defaults to "prod" when NODE_ENV=production and "dev" otherwise, so an
# existing deployment keeps working without setting it.
#
# Long polling is permitted ONLY when this is "dev". Setting it to staging or
# prod with TELEGRAM_POLLING_ENABLED=true makes the process refuse to boot.
TELEGRAM_ENV=dev

# Long polling is a development convenience. Leave unset: it defaults to true
# only for TELEGRAM_ENV=dev and false everywhere else. Setting it to "true" in
# staging/prod is a startup error.
# TELEGRAM_POLLING_ENABLED=false

# ── Hardening rollout flags ────────────────────────────────────────────────
# Legacy one-time sign-in code minted by the bot (/login). Default false. The
# code is a bearer credential; PKCE web-login replaces it.
LEGACY_TG_CODE_ENABLED=false

# Step-up enforcement on money movement. Start false so the middleware runs in
# log-only mode, then flip to true once the metrics look right.
WITHDRAW_STEPUP_ENFORCED=false

# Hours a cooling-off lock is applied after a sensitive account change
# (Telegram link/unlink, new payout method, password or email change).
COOLING_OFF_HOURS=24

# Current consent versions. Bump to force re-consent before sensitive actions.
TERMS_VERSION=1.0
PRIVACY_VERSION=1.0

# Social sign-in. Each is independently gated: when unset the button is hidden
# client-side and the endpoint answers 503 NOT_CONFIGURED. There is deliberately
# no unverified fallback.
# GOOGLE_CLIENT_ID must stay byte-identical to the frontend's
# VITE_GOOGLE_CLIENT_ID (the backend checks the id_token audience against it).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

SENTRY_DSN=

# ── Public origins ─────────────────────────────────────────────────────────
# TWO different origins, deliberately not merged:
#
#   API_PUBLIC_URL    this API, as reachable from the public internet. Used to
#                     build MACHINE-TO-MACHINE callbacks only (Telebirr
#                     notify_url, provider return URLs). Required in
#                     production; the app refuses to boot without it.
#   FRONTEND_URL      the web app. Used for USER-FACING redirects only
#                     (payment return, reset-password email, bot deep links).
#
# Deriving a provider callback from FRONTEND_URL delivers money-confirming
# webhooks to the web app host, which cannot route them — and does so
# silently, so top-ups simply never settle.
# No trailing slash.
# API_PUBLIC_URL=https://api.yekis.com

# Staff console, as opened from the bot's /staff command. Required in
# production. There is intentionally NO hardcoded fallback domain: a fallback
# sends staff to a host nobody controls.
# STAFF_CONSOLE_URL=https://console.yekis.com

# Public origin of the web app. Every "open the web app" link the Telegram bot
# emits is built from this â€” /start's sign-in button, /login, /contracts,
# /disputes, /proposals, and the chat menu button.
#
#   Production : https://app.yekis.et      (your real origin)
#   Local dev  : http://localhost:5173    works only in a browser on this machine
#   From a phone: use an https tunnel, e.g.
#                  npx localtunnel --port 5173     -> https://xxx.loca.lt
#                  ngrok http 5173                 -> https://xxx.ngrok.io
#                then set FRONTEND_URL to that https origin and TRUST_PROXY_HOPS=1.
#
# In production FRONTEND_URL MUST be https: the app refuses to start otherwise,
# because the Mini App and its tokens would otherwise travel in cleartext.
#
# The value is used verbatim. Do NOT point it at a placeholder domain: a
# Telegram Mini App button additionally requires a PUBLIC https origin, so with
# a loopback/LAN/http value the bot omits that button (and logs a warning at
# boot) rather than handing members a link that cannot resolve.
FRONTEND_URL=http://localhost:5173

# ── Reverse proxy (hardening T0.5) ──────────────────────────────────────────
# Number of trusted proxy hops IN FRONT of this API (1 for a single
# nginx/ALB/ngrok, 2 when Cloudflare sits in front of nginx).
#
# This is a COUNT, not a boolean. Express walks X-Forwarded-For from the RIGHT
# for exactly this many hops and discards anything further left. Every rate
# limit is keyed on the resulting req.ip, so:
#   too high  -> a client can prepend forged addresses and choose its own bucket
#   too low   -> every client collapses onto the proxy's address
# Leave UNSET when the API is reached directly (localhost), which means no
# proxy is trusted and X-Forwarded-For is ignored entirely.
# TRUST_PROXY_HOPS=1

# Confirm with counsel before changing (see Phase 0 legal brief)
MINIMUM_CONTRACTING_AGE=18

# Confirm with the accountant before changing
WITHHOLDING_THRESHOLD_MINOR=1000000
WITHHOLDING_RATE_WITH_TIN=0.03
WITHHOLDING_RATE_WITHOUT_TIN=0.3

# Contract Clause 2.2(b): automatic release after SEVEN calendar days of client inaction
AUTO_RELEASE_WINDOW_DAYS=7

# TMS / AML red-flag rules (Master Design Â§11.4) â€” confirm final figures
# with the Compliance Officer before production
TMS_SCAN_CRON=*/15 * * * *
TMS_STRUCTURING_WINDOW_HOURS=168
TMS_STRUCTURING_MIN_COUNT=2
TMS_STRUCTURING_TOTAL_THRESHOLD_MINOR=50000000
TMS_VELOCITY_WINDOW_HOURS=48
TMS_VELOCITY_BASELINE_DAYS=90
TMS_VELOCITY_MULTIPLIER=3
TMS_VELOCITY_FLOOR_RELEASES=6
TMS_ROUND_AMOUNT_WINDOW_DAYS=7
TMS_ROUND_AMOUNT_MIN_COUNT=3
TMS_ROUND_AMOUNT_UNIT_MINOR=1000000
# ==============================================================================
# Customer support chat needs NO extra configuration.
#
# Support runs entirely on the platform's own engine: the public widget creates a
# ticket via POST /api/v1/chat/guest, which returns a token scoped to that one
# conversation. That token lets the visitor read replies and send follow-ups
# without an account. Staff work the queue in the admin dashboard.
# ==============================================================================