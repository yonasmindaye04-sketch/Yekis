# Copy to .env and fill in. Never commit the real .env file.

NODE_ENV=development
PORT=4000

# Local dev matches docker-compose.yml exactly
DATABASE_URL=postgresql://marketplace:marketplace_dev_only@localhost:5433/marketplace
REDIS_URL=redis://localhost:6379

# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=replace_me_with_a_real_32plus_char_secret
JWT_REFRESH_SECRET=replace_me_with_a_different_32plus_char_secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# MinIO locally (matches docker-compose.yml); swap for the real Ethiopian-hosted
# S3-compatible endpoint in staging/production — see the infra discussion on
# data residency (PDPP Art. 22) before picking a provider.
OBJECT_STORE_ENDPOINT=http://localhost:9000
OBJECT_STORE_BUCKET=marketplace-dev
OBJECT_STORE_ACCESS_KEY=marketplace
OBJECT_STORE_SECRET_KEY=marketplace_dev_only

# Leave blank until you have real sandbox credentials from each provider
# (PAY-001/PAY-002: Telebirr + CBE are the approved rails; Chapa removed)
TELEBIRR_MERCHANT_ID=
TELEBIRR_API_KEY=
TELEBIRR_WEBHOOK_SECRET=local-development-webhook-secret-change-me
CBE_WEBHOOK_SECRET=

# Telegram Bot
# Get from @BotFather
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_URL=https://your-domain.com/api/v1/telegram/webhook
TELEGRAM_WEBHOOK_SECRET=generate-with-openssl-rand-base64-32

SENTRY_DSN=

# Confirm with counsel before changing (see Phase 0 legal brief)
MINIMUM_CONTRACTING_AGE=18

# Confirm with the accountant before changing
WITHHOLDING_THRESHOLD_MINOR=1000000
WITHHOLDING_RATE_WITH_TIN=0.03
WITHHOLDING_RATE_WITHOUT_TIN=0.3

# Contract Clause 2.2(b): automatic release after SEVEN calendar days of client inaction
AUTO_RELEASE_WINDOW_DAYS=7

# TMS / AML red-flag rules (Master Design §11.4) — confirm final figures
# with the Compliance Officer before production
TMS_SCAN_CRON=*/15 * * * *
TMS_STRUCTURING_WINDOW_HOURS=168
TMS_STRUCTURING_MIN_COUNT=2
TMS_STRUCTURING_TOTAL_THRESHOLD_MINOR=50000000
TMS_VELOCITY_WINDOW_HOURS=48
TMS_VELOCITY_BASELINE_DAYS=90
TMS_VELOCITY_MULTIPLIER=3
TMS_VELOCITY_FLOOR_RELEASES=6
TMS_ROUND_AMOUNT_WINDOW_DAYS=7
TMS_ROUND_AMOUNT_MIN_COUNT=3
TMS_ROUND_AMOUNT_UNIT_MINOR=1000000
