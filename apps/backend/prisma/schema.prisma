// Ethiopian Freelance Marketplace — Core Data Model
// Encodes: tiered KYC, the escrow state machine, the dispute flow, and
// append-only audit logging required for AML (10-year retention).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Enums ----------

enum StaffRole {
  // Legacy baseline roles — DO NOT RENAME/REMOVE (see ADMIN_PHASE1_PLAN.md).
  COMPLIANCE_OFFICER
  ADMIN
  SUPPORT
  // Phase 1 RBAC expansion (additive only):
  SUPER_ADMIN       // full platform control incl. admin/role management + settings
  OPERATIONS_ADMIN  // contracts, escrow, payments, payouts operations
  FINANCE_ADMIN     // ledger, reconciliation, receipts, reports, fee settings
  DISPUTE_MEDIATOR  // disputes + arbitration casework
  COMPLIANCE_ADMIN  // KYC + TMS/AML queue administration
}

enum KycDocumentType {
  NATIONAL_ID
  PASSPORT
  DRIVERS_LICENSE
  SELFIE_LIVENESS
  TIN_CERTIFICATE
  BUSINESS_REGISTRATION
}

enum UserRole {
  CLIENT
  FREELANCER
  BOTH
}

enum KycTier {
  TIER_1 // basic ID, phone, address — required for browsing/bidding
  TIER_2 // + TIN or business registration, bank details — required for withdrawal
  TIER_3 // enhanced due diligence — PEP / high-volume
}

enum KycStatus {
  PENDING
  UNDER_REVIEW
  VERIFIED
  REJECTED
}

enum ContractStatus {
  ACTIVE
  COMPLETED
  TERMINATED
  // Client exercised the statutory 7-day cooling-off cancellation right
  // (Electronic Transactions Proclamation No. 1205/2020) before any work started.
  CANCELLED
}

enum EscrowState {
  PAYMENT_PENDING
  ESCROW_HELD
  WORK_IN_PROGRESS
  SUBMITTED_FOR_REVIEW
  ACCEPTED
  RELEASED
  DISPUTED
  REFUNDED
  PARTIAL_REFUND
}

enum DisputeStage {
  NONE
  STAGE_1_NEGOTIATION
  STAGE_2_EVIDENCE
  STAGE_3_MEDIATION
  STAGE_4_ARBITRATION
  RESOLVED
}

enum DisputeCategory {
  NON_DELIVERY
  LATE_DELIVERY
  QUALITY_ISSUE
  SCOPE_CREEP
  NON_PAYMENT
  COMMUNICATION_BREAKDOWN
}

enum PaymentProvider {
  TELEBIRR
  CHAPA
  CBE_BIRR
  M_PESA
}

enum JobStatus {
  OPEN
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum ProposalStatus {
  SUBMITTED
  SHORTLISTED
  ACCEPTED
  REJECTED
  WITHDRAWN
  COUNTER_OFFERED
}

enum LaunchCategory {
  WEB_APP_DEVELOPMENT
  GRAPHIC_DESIGN
  DIGITAL_MARKETING
  CONTENT_WRITING
  TRANSLATION
  DATA_ENTRY
}

enum Visibility {
  PUBLIC // anyone can view
  PROPOSERS // only users who proposed to their jobs (clients) or received proposals (freelancers)
  PRIVATE // only visible to self + staff
}

enum SkillCategory {
  DEVELOPMENT
  DESIGN
  MARKETING
  WRITING
  TRANSLATION
  DATA_ENTRY
  VIDEO_AUDIO
  BUSINESS
  ENGINEERING
  OTHER
}

enum ReviewDisputeResolution {
  REVIEW_REMOVED
  REVIEW_EDITED
  NO_ACTION
}

enum FeaturedReason {
  TOP_RATED
  RECENTLY_VERIFIED
  STAFF_PINNED
  CATEGORY_BALANCING
  COLD_START
}

enum ReportReason {
  FAKE_IDENTITY
  OFFENSIVE_CONTENT
  OFF_PLATFORM_CONTACT
  MISLEADING_SKILLS
  SPAM
  OTHER
}

enum ReportStatus {
  PENDING
  UNDER_REVIEW
  RESOLVED_NO_ACTION
  RESOLVED_PROFILE_HIDDEN
  RESOLVED_PROFILE_BANNED
}

// ---------- Core identity ----------

model User {
  id                      String     @id @default(cuid())
  ucid                    String     @unique @default(cuid()) // platform-wide Unique Customer ID
  email                   String     @unique
  phone                   String     @unique
  passwordHash            String
  role                    UserRole
  languagePreference      String     @default("en")
  timezone                String     @default("Africa/Addis_Ababa") @db.VarChar(60)
  // Nullable: Telegram/guest-chat signups have no verified DOB yet; fabricating
  // one corrupted KYC data (AML integrity). Real DOB arrives via Tier-2 Fayda.
  dateOfBirth             DateTime?
  faydaPsut               String?    @unique @map("fayda_biometric_id") // set once Fayda verification succeeds — used for dedup
  isComplianceHeld        Boolean    @default(false)
  complianceHeldAt        DateTime?
  complianceHeldReason    String?
  circumventionAlertCount Int        @default(0)
  isSuspended             Boolean    @default(false)
  staffRole               StaffRole? // null for regular users; set for Compliance Officer / Admin accounts

  cachedKycTier        KycTier?
  cachedKycStatus      KycStatus? @default(PENDING)
  totalEarnedNetMinor  Int        @default(0)
  totalSpentGrossMinor Int        @default(0)

  // --- PROFILE FIELDS ---
  firstName           String     @default("") @db.VarChar(50)
  lastName            String     @default("") @db.VarChar(50)
  displayName         String?    @db.VarChar(100) // computed fallback: "{firstName} {lastName}"
  bio                 String?    @db.VarChar(2000)
  avatarUrl           String?    @db.VarChar(500)
  avatarCdnUrls       Json? // { "64": "...", "256": "...", "512": "..." }
  primarySkillId      String?    @db.VarChar(50)
  primarySkill        Skill?     @relation(fields: [primarySkillId], references: [id])
  isAvailableForWork  Boolean    @default(true)
  profileVisibility   Visibility @default(PUBLIC)
  profileCompleteness Int        @default(0) // 0-100, computed

  // --- STATS (COMPUTED, CACHED) ---
  totalJobsCompleted  Int       @default(0)
  totalJobsPosted     Int       @default(0)
  ratingAverage       Float?    @default(0) // Bayesian average, not raw mean
  ratingCount         Int       @default(0)
  ratingBayesianScore Float?    @default(0) // used for sorting
  lastFeaturedAt      DateTime? // when they were last in carousel
  profileViewCount    Int       @default(0)

  // --- OAUTH PROVIDERS (social sign-in) ---
  emailVerified Boolean @default(false)
  googleId      String? @unique
  appleId       String? @unique
  facebookId    String? @unique

  // --- TELEGRAM ---
  telegramUserId BigInt? @unique
  telegramChatId String?

  // --- TIMESTAMPS ---
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // --- EXISTING RELATIONS ---
  kyc                      KycRecord?
  wallet                   Wallet?
  jobsPosted               Job[]                     @relation("ClientJobs")
  proposals                Proposal[]
  contractsAsClient        Contract[]                @relation("ClientContracts")
  contractsAsFreelancer    Contract[]                @relation("FreelancerContracts")
  consents                 ConsentRecord[]
  auditLogs                AuditLog[]
  notifications            Notification[]
  transactionFlags         TransactionFlag[]
  walletTopUps             WalletTopUp[]
  payouts                  PayoutTransaction[]
  conversationsCreated     Conversation[]            @relation("ConversationCreator")
  conversationsAssigned    Conversation[]            @relation("ConversationAssignedStaff")
  conversationParticipants ConversationParticipant[]
  chatMessages             ChatMessage[]

  sentDirectMessages        DirectMessage[]
  directThreadsAsClient     DirectThread[]  @relation("ClientThreads")
  directThreadsAsFreelancer DirectThread[]  @relation("FreelancerThreads")

  // --- GIG RELATIONS ---
  gigsOwned   Gig[]       @relation("GigFreelancer")
  gigOrders   GigOrder[]  @relation("GigOrderClient")
  gigAuthored GigReview[] @relation("GigReviewAuthor")
  gigReceived GigReview[] @relation("GigReviewTarget")

  // --- PROFILE RELATIONS ---
  skills               UserSkill[]
  portfolioItems       PortfolioItem[]
  reviewsReceived      Review[]             @relation("ReviewTarget")
  reviewsGiven         Review[]             @relation("ReviewAuthor")
  featuredLogs         FeaturedLog[]
  profileReports       ProfileReport[]      @relation("ReportedUser")
  passwordResetTokens  PasswordResetToken[]
  notificationSettings Json?

  @@index([faydaPsut])
}

model ConsentRecord {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  purpose   String // e.g. "kyc_data_processing", "marketing", "analytics"
  granted   Boolean
  grantedAt DateTime @default(now())

  @@index([userId])
}

// ---------- KYC (tiered) ----------

model KycRecord {
  id                         String    @id @default(cuid())
  userId                     String    @unique
  user                       User      @relation(fields: [userId], references: [id])
  tier                       KycTier   @default(TIER_1)
  status                     KycStatus @default(PENDING)
  highestVerifiedTier        KycTier?
  fullName                   String?
  documentNumber             String?
  tin                        String? // required for Tier 2 (withdrawal eligibility)
  businessRegNumber          String?
  isPepMatch                 Boolean   @default(false)
  pepScreenedAt              DateTime?
  faydaVerificationAttempted Boolean   @default(false)
  faydaVerificationSucceeded Boolean   @default(false)
  esignetSub                 String?
  esignetVerifiedName        String?
  esignetVerifiedDob         String?
  esignetVerifiedAt          DateTime?
  reviewedByStaffId          String? // staff user who made the manual VERIFIED/REJECTED call
  rejectionReason            String?
  lastVerifiedAt             DateTime?
  nextReviewDueAt            DateTime? // periodic KYC refresh job reads this
  // T2-J: set by kycRefresh.worker; surfaces in getReviewQueue as a distinct filter
  // so staff can see re-review cases separately from first-time submissions.
  periodicReviewPending      Boolean   @default(false)
  createdAt                  DateTime  @default(now())
  updatedAt                  DateTime  @updatedAt

  documents    KycDocument[]
  reviewEvents KycReviewEvent[]
}

model KycReviewEvent {
  id             String    @id @default(cuid())
  kycRecordId    String
  kycRecord      KycRecord @relation(fields: [kycRecordId], references: [id])
  staffUserId    String
  decision       KycStatus // VERIFIED or REJECTED (PENDING/UNDER_REVIEW never logged here)
  tierAtDecision KycTier
  reason         String?
  createdAt      DateTime  @default(now())

  @@index([kycRecordId])
}

model KycDocument {
  id           String          @id @default(cuid())
  kycRecordId  String
  kycRecord    KycRecord       @relation(fields: [kycRecordId], references: [id])
  documentType KycDocumentType
  storagePath  String // pointer into WORM object store — never the raw file in the DB
  uploadedAt   DateTime        @default(now())

  @@index([kycRecordId])
}

// ---------- Jobs & Proposals ----------

model Job {
  id                 String         @id @default(cuid())
  clientId           String
  client             User           @relation("ClientJobs", fields: [clientId], references: [id])
  title              String
  category           LaunchCategory
  description        String
  budgetMinMinor     Int
  budgetMaxMinor     Int
  deadline           DateTime
  status             JobStatus      @default(OPEN)
  // Client's proposed milestone plan at posting time — informational until
  // a proposal is accepted, at which point Contracts.milestones are seeded
  // from whichever plan (this one, possibly renegotiated via the accepted
  // Proposal) the two parties actually agreed to.
  proposedMilestones Json
  screeningQuestions Json?
  createdAt          DateTime       @default(now())

  proposals     Proposal[]
  contract      Contract?
  directThreads DirectThread[]

  @@index([category, status])
  @@index([clientId])
}

model Proposal {
  id                 String         @id @default(cuid())
  jobId              String
  job                Job            @relation(fields: [jobId], references: [id])
  freelancerId       String
  freelancer         User           @relation(fields: [freelancerId], references: [id])
  coverLetter        String
  quotedAmountMinor  Int
  estimatedDays      Int
  milestoneBreakdown Json // freelancer's proposed milestone/payment split
  screeningAnswers   Json?
  attachmentPaths    String[]
  status             ProposalStatus @default(SUBMITTED)
  createdAt          DateTime       @default(now())

  counterOffer CounterOffer?

  @@unique([jobId, freelancerId]) // one active proposal per freelancer per job
  @@index([jobId])
  @@index([freelancerId])
}

// ---------- Contracts ----------

model Contract {
  id                   String         @id @default(cuid())
  jobId                String         @unique
  job                  Job            @relation(fields: [jobId], references: [id])
  clientId             String
  client               User           @relation("ClientContracts", fields: [clientId], references: [id])
  freelancerId         String
  freelancer           User           @relation("FreelancerContracts", fields: [freelancerId], references: [id])
  templateVersion      String // which Service Agreement template version was used
  documentStoragePath  String // the generated, immutable PDF
  status               ContractStatus @default(ACTIVE)
  clientAcceptedAt     DateTime?
  freelancerAcceptedAt DateTime?
  // T2-E: 7-day cooling-off right — Electronic Transactions Proclamation No. 1205/2020.
  // Client may cancel before this timestamp AND only while no milestone has progressed
  // past PAYMENT_PENDING (i.e. work has not started). See contracts.service.ts cancelDuringCoolingOff().
  // ⚠️ Conflict note: AUTO_RELEASE_WINDOW_DAYS default is 5 days. If a milestone were somehow
  // submitted AND the auto-release timer fires before cancellableUntil, auto-release must be
  // skipped — see autoRelease.worker.ts for the guard added to enforce this.
  cancellableUntil     DateTime? // set to createdAt + 7 days by createContractFromProposal()
  createdAt            DateTime       @default(now())

  milestones Milestone[]
  disputes   Dispute[] // one per milestone now that disputes are milestone-scoped
  review     Review?

  @@index([clientId])
  @@index([freelancerId])
  @@index([status])
}

model Milestone {
  id              String      @id @default(cuid())
  contractId      String
  contract        Contract    @relation(fields: [contractId], references: [id])
  title           String
  amountMinor     Int
  dueDate         DateTime
  escrowState     EscrowState @default(PAYMENT_PENDING)
  submittedAt     DateTime?
  deliverableUrl  String? // added to track the submitted file/link for review & disputes
  deliverableHash String?
  autoReleaseAt   DateTime? // set when freelancer submits; cron releases at this time if untouched
  releasedAt      DateTime?
  createdAt       DateTime    @default(now())

  paymentTransactions PaymentTransaction[]

  @@index([contractId])
  @@index([escrowState, autoReleaseAt])
}

// ---------- Payments ----------

model PaymentTransaction {
  id                    String          @id @default(cuid())
  milestoneId           String
  milestone             Milestone       @relation(fields: [milestoneId], references: [id])
  provider              PaymentProvider
  providerTransactionId String          @unique
  amountMinor           Int
  status                String // PENDING | SUCCESS | FAILED
  withholdingTaxMinor   Int             @default(0)
  rawWebhookPayload     Json?
  createdAt             DateTime        @default(now())

  @@index([milestoneId])
  // Reconciliation sweep query: provider + status + createdAt window
  @@index([provider, status, createdAt])
}

model Wallet {
  id           String   @id @default(cuid())
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id])
  balanceMinor Int      @default(0)
  updatedAt    DateTime @updatedAt

  topUps  WalletTopUp[]
  payouts PayoutTransaction[]
}

enum TopUpStatus {
  PENDING
  CHECKOUT_PENDING // Telebirr checkout initiated, awaiting webhook
  APPROVED
  REJECTED
  FLAGGED
}

// Manual receipt-based top-up: the client pays directly into the platform's
// own Telebirr/CBE account outside the app, then submits a receipt photo +
// reference number for staff to manually verify. Distinct from the
// milestone-funding escrow flow (escrow.service.ts / PaymentTransaction),
// which is webhook-driven — this exists specifically because Telebirr/CBE
// don't currently offer a confirmed webhook-based collection path for
// direct wallet top-ups the way they do for a per-milestone charge.
model WalletTopUp {
  id                    String          @id @default(cuid())
  userId                String
  user                  User            @relation(fields: [userId], references: [id])
  walletId              String
  wallet                Wallet          @relation(fields: [walletId], references: [id])
  provider              PaymentProvider
  amountMinor           Int
  referenceNumber       String          @default("")
  providerTransactionId String?         @unique // Telebirr merch_order_id for automatic checkout
  receiptImagePath      String? // object store pointer — null for automatic checkout top-ups
  status                TopUpStatus     @default(PENDING)
  reviewedByStaffId     String?
  rejectionReason       String?
  reviewedAt            DateTime?
  createdAt             DateTime        @default(now())

  @@index([status])
  @@index([userId])
}

// ---------- Disputes ----------

enum DisputeResolutionOutcome {
  RELEASE_TO_FREELANCER
  REFUND_TO_CLIENT
  PARTIAL_SPLIT
}

model Dispute {
  id                                     String                    @id @default(cuid())
  // Polymorphic subject: exactly one of contractId / gigOrderId is set.
  // contractId was previously NOT NULL + UNIQUE (one dispute per contract);
  // both are now nullable so gig orders can share the same dispute machine.
  contractId                             String?
  contract                               Contract?                 @relation(fields: [contractId], references: [id])
  gigOrderId                             String?                   @unique
  gigOrder                               GigOrder?                 @relation(fields: [gigOrderId], references: [id])
  milestoneId                            String?
  category                               DisputeCategory
  stage                                  DisputeStage              @default(STAGE_1_NEGOTIATION)
  raisedByUserId                         String
  description                            String
  negotiationDeadlineAt                  DateTime? // Stage 1 — 7 days from raise
  mediationDeadlineAt                    DateTime? // Stage 3 — 3-5 business days from escalation
  evidenceBundlePath                     String? // compiled Stage 2 package (object store pointer)
  evidenceBundleHash                     String?
  mediatorRecommendation                 String?
  resolvedByStaffId                      String?
  resolutionOutcome                      DisputeResolutionOutcome?
  freelancerShareMinor                   Int? // set only when resolutionOutcome is PARTIAL_SPLIT
  resolvedAt                             DateTime?
  // T2-I: mediator assignment — ensures two staff don't work the same case simultaneously
  assignedMediatorStaffId                String?
  assignedAt                             DateTime?
  // T2-F: mutual withdrawal — both parties must call /withdraw for this to close
  withdrawalRequestedByUserId            String? // first party to request mutual close
  withdrawalProposedOutcome              DisputeResolutionOutcome? // outcome they proposed
  withdrawalProposedFreelancerShareMinor Int?
  withdrawalConfirmedAt                  DateTime? // set when second party confirms matching outcome
  // T2-H: arbitration award tracking
  awardReferenceNumber                   String? // AACCSA or other arbitration body reference
  createdAt                              DateTime                  @default(now())
  updatedAt                               DateTime                  @updatedAt

  evidence DisputeEvidence[]

  @@index([contractId])
  @@index([gigOrderId])
  @@index([milestoneId])
  @@index([stage])
}

model DisputeEvidence {
  id                String   @id @default(cuid())
  disputeId         String
  dispute           Dispute  @relation(fields: [disputeId], references: [id])
  submittedByUserId String
  statement         String
  createdAt         DateTime @default(now())

  @@index([disputeId])
}

// ---------- Compliance: append-only audit log (10-year AML retention) ----------
// This table must NEVER be updated or deleted from application code — only
// inserted into. Enforce with a Postgres REVOKE UPDATE/DELETE at the DB role
// level in addition to this Prisma model (see prisma/README.md).

// ---------- Transaction Monitoring (AML) ----------

enum TransactionFlagType {
  STRUCTURING
  VELOCITY
  ROUND_AMOUNTS
  PASS_THROUGH
  WALLET_MISMATCH
  STAFF_FLAGGED
  VAT_THRESHOLD_REACHED // T2-D: platform fee revenue crossed the configurable VAT-alert threshold
}

enum TransactionFlagStatus {
  PENDING_REVIEW
  STR_FILED
  DISMISSED
}

model TransactionFlag {
  id                 String                @id @default(cuid())
  userId             String
  user               User                  @relation(fields: [userId], references: [id])
  type               TransactionFlagType
  status             TransactionFlagStatus @default(PENDING_REVIEW)
  details            Json // rule-specific context (e.g. matched transaction IDs, amounts)
  relatedEntityId    String? // milestoneId, PaymentTransaction id, or withdrawal reference
  reviewedByStaffId  String?
  reviewNotes        String?
  strFiledAt         DateTime?
  strReferenceNumber String? // the FIC filing reference the Compliance Officer received — filed manually, not via any API
  strDeadlineAt      DateTime?
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt

  @@index([status])
  @@index([userId])
}

// ---------- Notifications ----------

model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  type      String // matches the BullMQ job name, e.g. "dispute-raised", "escrow-funded"
  message   String
  metadata  Json?
  isRead    Boolean   @default(false)
  smsSentAt DateTime? // null if this type isn't SMS-critical, or SMS send failed/is stubbed
  createdAt DateTime  @default(now())

  @@index([userId, isRead])
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id])
  eventType  String // e.g. "ESCROW_RELEASED", "DISPUTE_RAISED", "KYC_STATUS_CHANGE"
  entityType String // e.g. "Milestone", "Dispute"
  entityId   String
  metadata   Json?

  // Phase 1 audit hardening (additive; existing rows remain valid with nulls):
  actorRole     String?   // staffRole of actor when acting in staff capacity
  action        String?   // canonical action name; defaults to eventType at write time
  previousState Json?     // state snapshot before the change
  newState      Json?     // state snapshot after the change
  amountMinor   Int?      // financial amount involved, when applicable (ETB cents)
  requestId     String?   // pino-http request id for request log correlation
  ipAddress     String?   // actor's client IP at the time of the action

  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([userId])
  @@index([action])
  @@index([createdAt])
}

// ---------- Support Chat ----------

model Conversation {
  id              String   @id @default(cuid())
  creatorId       String
  creator         User     @relation("ConversationCreator", fields: [creatorId], references: [id])
  assignedStaffId String? // staff member who claimed/was assigned to this conversation
  assignedStaff   User?    @relation("ConversationAssignedStaff", fields: [assignedStaffId], references: [id])
  subject         String
  status          String   @default("OPEN") // OPEN | CLOSED
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  participants ConversationParticipant[]
  messages     ChatMessage[]

  @@index([status])
  @@index([creatorId])
  @@index([assignedStaffId])
}

model ConversationParticipant {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  userId         String
  user           User         @relation(fields: [userId], references: [id])
  lastReadAt     DateTime?

  @@unique([conversationId, userId])
  @@index([conversationId])
  @@index([userId])
}

model ChatMessage {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  senderId       String
  sender         User         @relation(fields: [senderId], references: [id])
  body           String
  attachmentUrl  String? // optional file attachment stored in object store
  createdAt      DateTime     @default(now())

  @@index([conversationId])
  @@index([senderId])
}

// ---------- Skills Taxonomy ----------

model Skill {
  id           String        @id @db.VarChar(50) // slug: "ui-ux-design"
  nameEn       String        @db.VarChar(100)
  nameAm       String        @db.VarChar(100)
  category     SkillCategory
  isActive     Boolean       @default(true)
  displayOrder Int           @default(0)

  users        UserSkill[]
  primaryUsers User[]
}

model UserSkill {
  id        String   @id @default(cuid())
  userId    String
  skillId   String
  createdAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  skill Skill @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([userId, skillId])
  @@index([userId])
  @@index([skillId])
}

// ---------- Reviews ----------

model Review {
  id String @id @default(cuid())

  contractId String   @unique // one review per contract direction
  contract   Contract @relation(fields: [contractId], references: [id])

  authorId String
  author   User   @relation("ReviewAuthor", fields: [authorId], references: [id])

  targetUserId String
  targetUser   User   @relation("ReviewTarget", fields: [targetUserId], references: [id])

  rating  Int // 1-5
  comment String? @db.VarChar(2000)

  // Double-blind
  isBlind    Boolean   @default(true)
  revealedAt DateTime?

  // Response from target
  response    String?   @db.VarChar(1000)
  respondedAt DateTime?

  // Dispute
  isDisputed        Boolean                  @default(false)
  disputeReason     String?                  @db.VarChar(500)
  disputeResolvedAt DateTime?
  disputeResolution ReviewDisputeResolution?
  disputedByStaffId String?

  // Eligibility — only true after escrow-funded contract completion
  isEligible Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([targetUserId, isEligible, revealedAt])
  @@index([authorId])
  @@index([contractId])
}

// ---------- Portfolio ----------

model PortfolioItem {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  title        String  @db.VarChar(200)
  description  String? @db.VarChar(2000)
  thumbnailUrl String? @db.VarChar(500)
  projectUrl   String? @db.VarChar(500)
  isActive     Boolean @default(true)
  displayOrder Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, isActive])
}

// ---------- Featured Selection Log ----------

model FeaturedLog {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  featuredAt DateTime       @default(now())
  reason     FeaturedReason
  category   SkillCategory

  pinnedByStaffId String?
  notes           String? @db.VarChar(500)

  @@index([userId, featuredAt])
  @@index([featuredAt])
}

// ---------- Profile Reports ----------

model ProfileReport {
  id             String @id @default(cuid())
  reporterId     String
  reportedUserId String
  reportedUser   User   @relation("ReportedUser", fields: [reportedUserId], references: [id])

  reason  ReportReason
  details String?      @db.VarChar(1000)
  status  ReportStatus @default(PENDING)

  reviewedByStaffId String?
  staffNotes        String?   @db.VarChar(1000)
  resolvedAt        DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([reportedUserId])
  @@index([status])
}

// ---------- Profile Views (Analytics) ----------

model ProfileView {
  id           String   @id @default(cuid())
  viewerId     String? // null for anonymous
  targetUserId String
  viewedAt     DateTime @default(now())
  source       String?  @db.VarChar(50) // "carousel", "search", "bot", "direct"

  @@index([targetUserId, viewedAt])
  @@index([viewedAt])
}

// ---------- Counter Offers ----------

model CounterOffer {
  id                   String   @id @default(cuid())
  proposalId           String   @unique // one counter per proposal
  proposal             Proposal @relation(fields: [proposalId], references: [id])
  proposedByClientId   String
  revisedAmountMinor   Int
  revisedEstimatedDays Int
  revisedMilestones    Json // same shape as Proposal.milestoneBreakdown
  message              String   @db.VarChar(1000)
  status               String   @default("PENDING") // PENDING | ACCEPTED | DECLINED
  createdAt            DateTime @default(now())

  @@index([proposalId])
}

// ---------- Direct Messaging ----------

// A thread is tied to a specific (job, client, freelancer) triple.
// It is created automatically when either party sends the first message.
model DirectThread {
  id           String   @id @default(cuid())
  jobId        String
  job          Job      @relation(fields: [jobId], references: [id])
  clientId     String
  client       User     @relation("ClientThreads", fields: [clientId], references: [id])
  freelancerId String
  freelancer   User     @relation("FreelancerThreads", fields: [freelancerId], references: [id])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  messages DirectMessage[]

  @@unique([jobId, clientId, freelancerId])
  @@index([clientId])
  @@index([freelancerId])
}

model DirectMessage {
  id        String       @id @default(cuid())
  threadId  String
  thread    DirectThread @relation(fields: [threadId], references: [id])
  senderId  String
  sender    User         @relation(fields: [senderId], references: [id])
  body      String       @db.VarChar(4000) // sanitized by antiCircumventionMiddleware
  isRead    Boolean      @default(false)
  createdAt DateTime     @default(now())

  @@index([threadId, createdAt])
  @@index([senderId])
}

// ---------- Platform Ledger (T2-A, T2-B, T2-C) ----------
// Separates platform operating revenue from user wallet balances and escrow
// funds in flight, as required by the Master Design Document §Finance.
// The escrow pool is a DERIVED view (sum of ESCROW_HELD + SUBMITTED_FOR_REVIEW
// milestones) — not a separate balance stored here — since the Milestone
// escrow state is already the source of truth. Only platform fee revenue
// is stored here as an accumulated counter.
//
// IMPORTANT — TIER 3 BLOCKER: Opening a physically separate bank/Telebirr
// escrow account (required before real money flows) is a business action
// blocked on NBE licensing decision. See COMPLIANCE_BLOCKERS.md.

model PlatformOperatingAccount {
  // Singleton row — always upserted with id = "singleton" so there is
  // exactly one platform account regardless of how many fee credits occur.
  id                          String   @id @default("singleton")
  // Accumulated platform fee collected from freelancers (net of milestone amounts).
  // Does NOT include the client-side add-on (platformFeeFromClientMinor) which
  // stays in the escrow pool until milestone release. See fees.ts for the split.
  accumulatedFeeMinor         Int      @default(0)
  // Running total of withholding tax deducted — used for ERA remittance reconciliation.
  // This is an aggregate; per-transaction detail lives on PaymentTransaction.withholdingTaxMinor.
  accumulatedWithholdingMinor Int      @default(0)
  accumulatedVatMinor         Int      @default(0)
  updatedAt                   DateTime @updatedAt
}

// Append-only fee credit log — immutable record of each credit to the
// PlatformOperatingAccount, enabling per-milestone fee reconciliation.
model PlatformFeeCredit {
  id                     String     @id @default(cuid())
  // Nullable so a single append-only ledger supports both contract milestone
  // releases AND gig-order releases (see GIG_MODEL_PLAN.md). Exactly one of
  // these two reference strings is set per row. Deliberately NOT foreign-keyed:
  // the append-only ledger predates referential integrity and must tolerate
  // historical rows whose milestone was since retained outside the Milestone
  // relation (see DATABASE.md append-only convention).
  milestoneId            String?
  gigOrderId             String?
  // Freelancer-side fee (deducted from gross before freelancer gets paid)
  feeFromFreelancerMinor Int
  // Client-side add-on (collected when client funds; already in wallet debit)
  feeFromClientMinor     Int
  withholdingMinor       Int
  createdAt              DateTime   @default(now())

  @@index([milestoneId])
  @@index([gigOrderId])
  @@index([createdAt])
}

// Monthly withholding tax summary generated by withholdingRemittance.worker.ts.
// A human uses this to file with ERA — this platform does NOT file automatically.
// See COMPLIANCE_BLOCKERS.md §ERA Remittance for the TIER 3 blocker.
model WithholdingRemittanceReport {
  id                    String    @id @default(cuid())
  // ISO month: "2026-08" — one report per calendar month
  periodMonth           String    @unique @db.VarChar(7)
  totalWithholdingMinor Int // sum of withholdingTaxMinor across SUCCESS transactions in period
  transactionCount      Int // number of qualifying transactions
  // Set by staff once they have actually filed with ERA — not automated
  filedAt               DateTime?
  filedByStaffId        String?
  eraReferenceNumber    String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([periodMonth])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
}

// ---------- Gigs (Fiverr-style service packages) ----------
// See docs/GIG_MODEL_PLAN.md for the full design. Gigs reuse the existing
// EscrowState enum + calculateFees + Wallet + PlatformFeeCredit ledger so the
// same trust, fee, and withholding model governs both bidding and direct-buy.
// NOTE: Gig disputes intentionally deferred — the Dispute model is contract /
// milestone-scoped and requires a polymorphic refactor before gig orders can
// escalate through the formal five-stage process (tracked as open decision).

enum GigStatus {
  DRAFT
  ACTIVE
  PAUSED
  REJECTED
  ARCHIVED
}

enum GigPackageTier {
  BASIC
  STANDARD
  PREMIUM
}

enum GigOrderStatus {
  PENDING_PAYMENT
  ESCROW_HELD
  WORK_IN_PROGRESS
  SUBMITTED_FOR_REVIEW
  DISPUTED
  COMPLETED
  CANCELLED
}

enum GigRevisionStatus {
  NONE
  REQUESTED
  SUBMITTED
}

model Gig {
  id           String @id @default(cuid())
  freelancerId String
  freelancer   User   @relation("GigFreelancer", fields: [freelancerId], references: [id])

  title        String
  category     LaunchCategory
  description  String
  tags         Json
  faqJson      Json?
  requirements Json

  thumbnailUrl String?
  mediaUrls    Json

  status           GigStatus @default(DRAFT)
  // Moderation checkpoint (MVP: DRAFT -> ACTIVE via explicit submit) — see
  // GIG_MODEL_PLAN.md open decision #3.
  autoAcceptOrders Boolean   @default(true)
  maxRevisions     Int       @default(2)

  viewCount     Int   @default(0)
  ratingAverage Float @default(0)
  ratingCount   Int   @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  packages GigPackage[]
  orders   GigOrder[]

  @@index([freelancerId, status])
  @@index([category, status])
}

model GigPackage {
  id                String         @id @default(cuid())
  gigId             String
  gig               Gig            @relation(fields: [gigId], references: [id], onDelete: Cascade)
  tier              GigPackageTier
  title             String
  description       String
  deliveryDays      Int
  revisionsIncluded Int            @default(1)
  priceMinor        Int
  addOns            Json?

  orders GigOrder[]

  @@unique([gigId, tier])
}

model GigOrder {
  id        String     @id @default(cuid())
  gigId     String
  gig       Gig        @relation(fields: [gigId], references: [id])
  packageId String
  package   GigPackage @relation(fields: [packageId], references: [id])
  clientId  String
  client    User       @relation("GigOrderClient", fields: [clientId], references: [id])

  requirementsAnswer Json?

  status      GigOrderStatus @default(PENDING_PAYMENT)
  escrowState EscrowState    @default(PAYMENT_PENDING)

  submittedAt     DateTime?
  deliverableUrl  String?
  deliverableHash String?
  autoReleaseAt   DateTime?
  releasedAt      DateTime?

  revisionStatus      GigRevisionStatus @default(NONE)
  revisionRequestNote String?
  revisionsUsed       Int               @default(0)

  totalChargeMinor Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  review     GigReview?
  dispute    Dispute?

  @@index([gigId, status])
  @@index([clientId, status])
}

model GigReview {
  id           String   @id @default(cuid())
  orderId      String   @unique
  order        GigOrder @relation(fields: [orderId], references: [id])
  authorId     String
  author       User     @relation("GigReviewAuthor", fields: [authorId], references: [id])
  targetUserId String
  targetUser   User     @relation("GigReviewTarget", fields: [targetUserId], references: [id])

  rating          Int
  categoryRatings Json
  comment         String?

  isBlind    Boolean   @default(true)
  revealedAt DateTime?

  response    String?
  respondedAt DateTime?

  createdAt DateTime @default(now())

  @@index([targetUserId])
}

// ---------- General Ledger (Double-Entry Bookkeeping) ----------

enum LedgerAccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
}

model LedgerAccount {
  id           String            @id @default(cuid())
  code         String            @unique // e.g. "1000-ASSET-TELEBIRR", "2000-LIABILITY-ESCROW", "2001-USER-{userId}"
  name         String
  type         LedgerAccountType
  currency     String            @default("ETB")
  balanceMinor Int               @default(0) // Derived running balance cache
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  entries LedgerEntry[]

  @@index([type])
}

model LedgerJournal {
  id             String        @id @default(cuid())
  idempotencyKey String        @unique
  description    String
  referenceType  String        // e.g. "ESCROW_FUND", "MILESTONE_RELEASE", "WALLET_TOPUP", "WITHDRAWAL"
  referenceId    String?
  postedAt       DateTime      @default(now())

  entries LedgerEntry[]

  @@index([referenceType, referenceId])
  @@index([postedAt])
}

model LedgerEntry {
  id          String        @id @default(cuid())
  journalId   String
  journal     LedgerJournal @relation(fields: [journalId], references: [id], onDelete: Cascade)
  accountId   String
  account     LedgerAccount @relation(fields: [accountId], references: [id])
  // Invariant per journal: sum of all debits == sum of all credits
  debitMinor  Int           @default(0)
  creditMinor Int           @default(0)
  postedAt    DateTime      @default(now())

  @@index([accountId, postedAt])
  @@index([journalId])
}

// ---------- Payouts & Disbursements ----------

enum PayoutStatus {
  PENDING
  PROCESSING
  CONFIRMED
  FAILED
  REVERSED
}

model PayoutTransaction {
  id                      String          @id @default(cuid())
  userId                  String
  user                    User            @relation(fields: [userId], references: [id])
  walletId                String
  wallet                  Wallet          @relation(fields: [walletId], references: [id])
  amountMinor             Int             // gross amount requested from wallet
  feeMinor                Int             @default(0) // disbursement fee (e.g. 0.5% Telebirr)
  netAmountMinor          Int             // net transferred to user (amountMinor - feeMinor)
  provider                PaymentProvider
  providerPayoutId        String?         @unique // Telebirr / bank transaction reference
  payoutAccountIdentifier String          // phone number or bank account
  status                  PayoutStatus    @default(PENDING)
  errorMessage            String?
  createdAt               DateTime        @default(now())
  updatedAt               DateTime        @updatedAt
  settledAt               DateTime?

  @@index([userId, status])
  @@index([provider, status])
  @@index([createdAt])
}

