{
  "name": "backend",
  "version": "0.1.0",
  "private": true,
  "main": "dist/server.js",
  "scripts": {
    "predev": "pnpm prisma:generate && docker compose -f ../../docker-compose.yml up -d",
    "dev": "tsx watch src/server.ts",
    "infra:up": "docker compose -f ../../docker-compose.yml up -d",
    "prebuild": "pnpm prisma:generate",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "lint": "eslint src --ext .ts",
    "type-check": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "route-audit": "tsx scripts/route-audit.ts",
    "route-audit:check": "tsx scripts/route-audit.ts --check",
    "route-audit:baseline": "tsx scripts/route-audit.ts --write-baseline",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "db:check-fresh": "node ../../scripts/check-fresh-database.js",
    "prisma:studio": "prisma studio",
    "db:seed": "tsx prisma/seed.ts",
    "demo-activity:migration": "tsx scripts/generate-demo-activity-migration.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.658.1",
    "@aws-sdk/s3-request-presigner": "^3.658.1",
    "@grammyjs/conversations": "^2.1.1",
    "@grammyjs/i18n": "^1.1.2",
    "@grammyjs/runner": "^2.0.3",
    "@node-rs/argon2": "^1.8.3",
    "@prisma/client": "^5.19.1",
    "axios": "^1.20.0",
    "bullmq": "^5.12.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-async-errors": "^3.1.1",
    "express-rate-limit": "^7.4.0",
    "grammy": "^1.45.1",
    "helmet": "^7.1.0",
    "ioredis": "^5.4.1",
    "jose": "^5.10.0",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^9.0.5",
    "pdf-lib": "^1.17.1",
    "pino": "^9.4.0",
    "pino-http": "^10.3.0",
    "ws": "^8.21.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.5.5",
    "@types/nodemailer": "^8.0.1",
    "@types/supertest": "^7.2.1",
    "@types/ws": "^8.18.1",
    "eslint": "^8.57.0",
    "pino-pretty": "^13.1.3",
    "prisma": "^5.19.1",
    "supertest": "^7.3.1",
    "tsx": "^4.19.1",
    "typescript": "^5.9.3",
    "vitest": "^2.1.1"
  }
}
