# Optional: explicit API base URL. Leave unset to use the Vite proxy
# (`/api` -> http://localhost:4000) defined in vite.config.ts.
# VITE_API_BASE_URL=

# Google OAuth â€” must match the backend's GOOGLE_CLIENT_ID, since the
# backend verifies the Google id_token audience claim against the same value.
VITE_GOOGLE_CLIENT_ID=

# Apple "Sign in with Apple" Service ID (com.yekis.app, or
# com.yekis.app.web). Must match the backend's APPLE_CLIENT_ID. Without it the
# Apple button is hidden and sign-in is unavailable. Register the same
# redirect_uri here as in the Apple developer portal; the SPA callback page
# does not need to exist because sign-in runs in a popup.
VITE_APPLE_CLIENT_ID=

# Telegram bot handle WITHOUT the leading @. Only a fallback for when the
# backend is unreachable: GET /api/v1/auth/oauth/providers returns the
# authoritative value from the server's TELEGRAM_BOT_USERNAME.
VITE_TELEGRAM_BOT_USERNAME=

# Google Analytics 4 Measurement ID. When empty, the analytics module exits
# silently (no placeholder ID is loaded). gtag.js loads only in production
# builds (import.meta.env.PROD, never from `vite dev`) AND only AFTER the user
# accepts analytics cookies in the consent banner.
# DebugView: append ?ga_debug=1 to the URL on a production build.
# VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX

#
# Customer support chat needs NO extra configuration. The native support widget
# is always available on the landing pages and talks to /api/v1/chat/*.