# Optional: explicit API base URL. Leave unset to use the Vite proxy
# (`/api` -> http://localhost:4000) defined in vite.config.ts.
# VITE_API_BASE_URL=

# Google OAuth — must match the backend's GOOGLE_CLIENT_ID, since the
# backend verifies the Google id_token audience claim against the same value.
VITE_GOOGLE_CLIENT_ID=

# Google Analytics 4 Measurement ID. When empty, the analytics module exits
# silently (no placeholder ID is loaded). Only loaded AFTER the user accepts
# analytics cookies in the consent banner.
# VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX