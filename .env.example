# --- Telegram bot --------------------------------------------------
# Required. The API-token line @BotFather hands out. Never commit; the
# repo's `.gitignore` excludes `.env` and `scripts/scan-secrets.js`
# gates CI to that end. Rotate from @BotFather if it is ever exposed.
TELEGRAM_BOT_TOKEN=
# Required. Public handle of the bot, WITHOUT the leading @. The Login
# Widget and the deep links render against this handle, and the widget
# refuses to render when the handle does not match the bot whose token
# signs the payload.
TELEGRAM_BOT_USERNAME=

# One of "dev" / "staging" / "prod". Long polling is permitted only in
# "dev"; any other value forces webhook mode and refuse pollling on
# boot (assertProductionSafety). Stage "staging" for any reachable host.
TELEGRAM_ENV=
# "true" / "false". Effective only in dev. Polling is refused outside dev.
TELEGRAM_POLLING_ENABLED=
# Replay window for a signed initData string from the Mini App or the
# Login Widget, in seconds. Captured payloads expire after this.
TELEGRAM_INIT_DATA_MAX_AGE_SECONDS=
# Per-call budget for Bot API calls (milliseconds). 10000 covers any
# healthy response; bump it only when a route's p99 truly exceeds that.
TELEGRAM_API_TIMEOUT_MS=

# Required outside dev. Telegram delivers every update to this URL
# with the `X-Telegram-Bot-Api-Secret-Token` header set to
# TELEGRAM_WEBHOOK_SECRET. Must be a clean https URL pointing at this
# deployment's webhook route.
TELEGRAM_WEBHOOK_URL=
# Required outside dev. 32+ random characters, kept server-side; never
# accepted from the client (`POST /api/v1/telegram/set-webhook`
# refuses any secret payload and only reads it from this env).
TELEGRAM_WEBHOOK_SECRET=

# --- Telegram bot (frontend, build-time) ---------------------------
# Mirror of TELEGRAM_BOT_USERNAME. Read once by Vite during the SPA
# build; rebuild the SPA after a change. Set in `apps/frontend/.env`.
VITE_TELEGRAM_BOT_USERNAME=
