# =============================================================================
# Yekis - production environment template
# =============================================================================
#
# Copy this file to `.env.production` (never commit it) and fill every value
# marked REQUIRED. The API refuses to boot when a REQUIRED value is missing or
# unsafe; `node scripts/check-production-env.mjs --file .env.production` runs
# the same checks before a deploy and never prints a secret.
#
# Do not reuse the staging app, database or bucket. The staging app runs with
# NODE_ENV=staging, holds test data, and shares the Telegram bot with this
# deployment - one bot can only have one webhook.
#
# Values in <angle brackets> are placeholders. The validator rejects them.
# =============================================================================

# --- Runtime ---------------------------------------------------------------
# REQUIRED. "production" turns on the fail-closed checks in config/env.ts.
NODE_ENV=production
# REQUIRED. The container port AletCloud routes to.
PORT=8080
# REQUIRED. One container serves both the SPA and the API.
SERVE_FRONTEND=true
FRONTEND_DIST_DIR=/app/apps/frontend/dist
# REQUIRED. Apply Prisma migrations before the API starts.
RUN_MIGRATIONS=true
# AletCloud terminates TLS and forwards one hop.
TRUST_PROXY_HOPS=1
# true only on a dedicated domain. false on <app>.app.aletcloud.com, where
# includeSubDomains would force HTTPS on other tenants' subdomains.
HSTS_INCLUDE_SUBDOMAINS=true
# Must stay false in production.
RATE_LIMIT_DISABLED=false
# Must stay false in production; unverified money must never be minted.
ALLOW_MOCK_PAYMENT_AUTO_APPROVAL=false
# Must stay false in production.
FAYDA_SIMULATE_UNAVAILABLE=false
# Containment gate: must stay false in production until approved.
PARTIAL_SPLIT_ENABLED=false

# --- Public URLs -----------------------------------------------------------
# REQUIRED. All three are the same origin because one container serves the
# SPA, the API and the staff console.
FRONTEND_URL=https://app.your-domain.example
API_PUBLIC_URL=https://app.your-domain.example
STAFF_CONSOLE_URL=https://app.your-domain.example

# --- Database and Redis ----------------------------------------------------
# REQUIRED. Injected by AletCloud when the production database is connected
# to the app; the value below is only for a manual deployment.
DATABASE_URL=postgresql://user:password@db-host:5432/yekis_prod
# Optional. Unset means the entrypoint starts the bundled redis-server on
# loopback. Set only when a separate Redis is used.
REDIS_URL=
REDIS_PASSWORD=

# --- Signing secrets -------------------------------------------------------
# REQUIRED. At least 32 random characters each, and all three must differ.
# Rotating JWT_ACCESS_SECRET or JWT_REFRESH_SECRET signs every session out.
JWT_ACCESS_SECRET=<32+ random characters>
JWT_REFRESH_SECRET=<32+ random characters>
GUEST_SUPPORT_JWT_SECRET=<32+ random characters, distinct from both above>
JWT_ACCESS_TTL=1h
JWT_REFRESH_TTL=30d

# --- Telegram bot ----------------------------------------------------------
# REQUIRED. The same bot may serve only one deployment: stop the staging app
# (or disable its bot) before this webhook is registered.
TELEGRAM_BOT_TOKEN=<token from BotFather>
TELEGRAM_BOT_USERNAME=<handle without the leading @>
TELEGRAM_ENV=prod
TELEGRAM_POLLING_ENABLED=false
TELEGRAM_WEBHOOK_URL=https://app.your-domain.example/api/v1/telegram/webhook
# REQUIRED. 32+ random characters. Telegram sends it as the
# X-Telegram-Bot-Api-Secret-Token header on every update.
TELEGRAM_WEBHOOK_SECRET=<32+ random characters>
TELEGRAM_INIT_DATA_MAX_AGE_SECONDS=900
TELEGRAM_API_TIMEOUT_MS=10000
# Build-time mirror of TELEGRAM_BOT_USERNAME. Rebuild the SPA after a change.
VITE_TELEGRAM_BOT_USERNAME=<handle without the leading @>

# --- Object storage --------------------------------------------------------
# REQUIRED. AletCloud injects AWS_* aliases when the bucket is connected; the
# explicit OBJECT_STORE_* names always win.
OBJECT_STORE_ENDPOINT=https://s3.aletcloud.com
OBJECT_STORE_REGION=et-addis-1
OBJECT_STORE_BUCKET=<production bucket name>
OBJECT_STORE_ACCESS_KEY=<bucket access key>
OBJECT_STORE_SECRET_KEY=<bucket secret key>
OBJECT_STORE_FORCE_PATH_STYLE=true
# Build-time origin used by the uploader. Usually the same endpoint.
VITE_OBJECT_STORE_ORIGIN=https://s3.aletcloud.com

# --- Email -----------------------------------------------------------------
# brevo = HTTPS API, smtp = raw SMTP, auto = SMTP when configured else Brevo.
EMAIL_TRANSPORT=brevo
BREVO_API_KEY=<Brevo API key>
# The sender must be verified in Brevo, on a domain with SPF and DKIM.
EMAIL_FROM=Yekis <notifications@your-domain.example>
# Only when EMAIL_TRANSPORT=smtp.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false

# --- SMS -------------------------------------------------------------------
# Without a provider, withdrawal approval codes can only reach members with a
# linked Telegram chat. That is a launch blocker for payouts.
SMS_ETHIOPIA_API_KEY=<SMS provider key>

# --- Social sign-in --------------------------------------------------------
# The Google client must list the production origin under Authorized
# JavaScript origins, and the consent screen must be published (or the signing
# account added as a test user).
GOOGLE_CLIENT_ID=<Google OAuth client id>
GOOGLE_CLIENT_SECRET=
VITE_GOOGLE_CLIENT_ID=<same Google OAuth client id>
APPLE_CLIENT_ID=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
VITE_APPLE_CLIENT_ID=

# --- Telebirr --------------------------------------------------------------
# REQUIRED when any Telebirr credential is present. Production refuses the
# developer-portal host and the sandbox environment.
TELEBIRR_ENV=production
TELEBIRR_BASE_URL=<Telebirr production gateway URL>
TELEBIRR_WEB_BASE_URL=<Telebirr production web-checkout URL>
TELEBIRR_FABRIC_APP_ID=<fabric app id>
TELEBIRR_APP_SECRET=<fabric app secret>
TELEBIRR_MERCHANT_APP_ID=<merchant app id>
TELEBIRR_MERCHANT_CODE=<merchant shortcode>
TELEBIRR_PRIVATE_KEY=<RSA private key PEM>
TELEBIRR_PUBLIC_KEY=<Telebirr RSA public key PEM>
TELEBIRR_TIMEOUT_EXPRESS=120m

# No approved merchant API exists for these rails; leave them off.
CBE_BIRR_CHECKOUT_ENABLED=false
CBE_WEBHOOK_ENABLED=false
CBE_WEBHOOK_SECRET=
MPESA_CHECKOUT_ENABLED=false

# --- Compliance ------------------------------------------------------------
# Production refuses PEP_PROVIDER=mock. NOTE: no real screening vendor is
# implemented yet, so every Tier 2 screen is escalated to manual review.
# Selecting the vendor is a Compliance Officer decision.
PEP_PROVIDER=real
# REQUIRED. Money movement must keep the step-up second factor on.
WITHDRAW_STEPUP_ENFORCED=true
TIN_FEATURE_ENABLED=false
MINIMUM_CONTRACTING_AGE=18
TERMS_VERSION=<version approved by counsel>
PRIVACY_VERSION=<version approved by counsel>
AUDIT_RETENTION_YEARS=10
COOLING_OFF_DAYS=7
AUTO_RELEASE_WINDOW_DAYS=7

# Fayda / eSignet (Tier 1 KYC). Unset means manual review.
ESIGNET_DISCOVERY_URL=
ESIGNET_CLIENT_ID=
ESIGNET_REDIRECT_URI=
ESIGNET_PRIVATE_KEY_JWK_B64=
ESIGNET_SCOPES=openid profile phone address

# --- Monitoring ------------------------------------------------------------
# SENTRY_DSN is declared in config/env.ts but no Sentry client is installed
# or initialised yet. Setting it has no effect; central logging is currently
# the AletCloud runtime log. Keep the gap visible rather than implied.
SENTRY_DSN=
OPENSEARCH_URL=

# --- Fees, TMS and SLA -----------------------------------------------------
# Defaults match docs/DECISIONS.md. Override only with a recorded decision.
PLATFORM_FEE_RATE_CLIENT=0
PLATFORM_FEE_RATE_FREELANCER=0.07
PAYMENT_PROVIDER_FEE_RATE=0.005
VAT_THRESHOLD_MINOR=45000000
VAT_RATE=0.15
VAT_REGISTERED=false
