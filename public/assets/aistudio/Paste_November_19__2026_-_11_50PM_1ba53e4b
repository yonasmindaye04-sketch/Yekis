registerPanel.hidden = !reg;
registerExtra.hidden = !reg;
loginPanel.hidden = reg;
nameField.required = reg;
submitBtn.textContent = reg ? 'Create profile' : 'Sign in';
titleEl.textContent = reg ? 'Start building' : 'Welcome back';
descEl.textContent = reg
? 'Create a local demo profile, or sign in with one you already made on this device.'
: 'Sign in with the email you used to register a local demo profile.';
errorEl.textContent = '';
}
function openDialog(next, category){
setMode(next);
formView.hidden = false;
successView.hidden = true;
form.reset();
if (category) categoryField.value = category;
errorEl.textContent = '';
if (typeof dialog.showModal === 'function') dialog.showModal();
else dialog.setAttribute('open','');
setTimeout(function(){ (next === 'register' ? nameField : emailField).focus(); }, 30);
}
function closeDialog(){
if (typeof dialog.close === 'function') dialog.close();
else dialog.removeAttribute('open');
}
/* Integration hook: listen for `yekis:start`, preventDefault, or set
window.YekisStack.onStart = function(mode, category){ ... }. */
window.YekisStack = {
onStart: null,
goToCard: goToCard,
goToOutro: goToOutro
};
function start(mode, category){
var ev = new CustomEvent('yekis:start', {detail:{mode:mode, category:category || null}, cancelable:true});
window.dispatchEvent(ev);
if (ev.defaultPrevented) return;
if (typeof window.YekisStack.onStart === 'function'){
window.YekisStack.onStart(mode, category || null);
return;
}
openDialog(mode, category);
}
document.querySelectorAll('[data-start]').forEach(function(btn){
btn.addEventListener('click', function(){ start(btn.dataset.start, btn.dataset.category); });
});
cards.forEach(function(card){
function activate(){ start('register', card.dataset.category); }
card.addEventListener('click', activate);
card.addEventListener('keydown', function(e){
if (e.key === 'Enter' || e.key === ' '){ e.preventDefault(); activate(); }
});
});
tabs.forEach(function(t){ t.addEventListener('click', function(){ setMode(t.dataset.mode); }); });
document.getElementById('dialog-close').addEventListener('click', closeDialog);
document.getElementById('success-done').addEventListener('click', closeDialog);
dialog.addEventListener('click', function(e){ if (e.target === dialog) closeDialog(); });
form.addEventListener('submit', function(e){
e.preventDefault();
errorEl.textContent = '';
var email = emailField.value.trim().toLowerCase();
if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)){
errorEl.textContent = 'Enter a valid email address.';
emailField.focus();
return;
}
var profiles = readProfiles();
var profile;
if (mode === 'register'){
var name = nameField.value.trim();
if (name.length < 2){
errorEl.textContent = 'Enter your full name.';
nameField.focus();
return;
}
profile = {name:name, email:email, role:roleField.value, category:categoryField.value};
var existing = profiles.findIndex(function(p){ return p.email === email; });
if (existing >= 0) profiles[existing] = profile; else profiles.push(profile);
writeProfiles(profiles);
document.getElementById('success-title').textContent = 'Profile ready';
document.getElementById('success-desc').textContent = 'Saved locally in this browser. Connect your auth service to make it live.';
} else {
profile = profiles.find(function(p){ return p.email === email; });
if (!profile){
errorEl.textContent = 'No local profile found for that email. Register first.';
return;
}
document.getElementById('success-title').textContent = 'Welcome back';
document.getElementById('success-desc').textContent = 'Signed in to your local demo profile.';
}
document.getElementById('success-name').textContent = profile.name;
document.getElementById('success-email').textContent = profile.email;
document.getElementById('success-role').textContent = profile.role;
document.getElementById('success-category').textContent = profile.category;
formView.hidden = true;
successView.hidden = false;
document.getElementById('success-done').focus();
});
/* Smooth anchor jumps. */
document.querySelectorAll('a[href^="#"]').forEach(function(a){
a.addEventListener('click', function(e){
var id = a.getAttribute('href').slice(1);
var target = document.getElementById(id);
if (!target) return;
e.preventDefault();
var y = target.getBoundingClientRect().top + window.scrollY - (id === 'top' ? 0 : 8);
window.scrollTo({top:y, behavior: reduced ? 'auto' : 'smooth'});
});
});
window.addEventListener('pagehide', function(){ cancelAnimationFrame(raf); });
})();
</script>
