<script>
(function(){
'use strict';
/* ── stack tuning — HTML deck behaviour ───────────────────────────── */
var Y_OFFSET = 3.2;
var SCALE_STEP = 0.06;
var ENTER_Y = 62, ENTER_RX = -16, ENTER_SCALE = 0.88;
var CARD_MS = 950, STAGGER_MS = 110;
var TILT_X = 2.6, TILT_Y = 3.4;
var VEL_KICK = 240, VEL_MAX = 6;
var PARALLAX = 7;
var CARD_LOOP_MS = 7000, CARD_REVEAL_MS = 6000;
var cards = Array.prototype.slice.call(document.querySelectorAll('.stk-card'));
var copies = cards.map(function(c){ return c.querySelector('.stk-copy'); });
var medias = cards.map(function(c){ return c.querySelector('.stk-media'); });
var total = cards.length;
var segment = 1 / (total - 1);
var introTotal = (total - 1) * STAGGER_MS + CARD_MS;
var wrap = document.getElementById('stk-wrap');
var pin = document.getElementById('stk-pin');
var stage = document.getElementById('stk-stage');
var cur = document.getElementById('cur');
var hud = document.getElementById('hud');
var dotsNav = document.getElementById('dots');
var outro = document.getElementById('stk-outro');
var cue = document.getElementById('cue');
var cueLabel = document.getElementById('cue-label');
var reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
var isCard = new URLSearchParams(window.location.search).has('card');
var activeIndex = -1;
var wrapTop = 0, span = 1;
var raf = 0;
if (isCard) {
document.body.classList.add('is-card');
}
function lerp(a,b,t){ return a + (b - a) * t; }
function clamp(v,lo,hi){ return v < lo ? lo : v > hi ? hi : v; }
function easeOutExpo(t){ t = clamp(t,0,1); return t >= 1 ? 1 : 1 - Math.pow(2, -10 * t); }
function pad(n){ return String(n).padStart(2,'0'); }
function measure(){
wrapTop = wrap.getBoundingClientRect().top + window.scrollY;
span = Math.max(1, wrap.offsetHeight - window.innerHeight);
}
measure();
if ('ResizeObserver' in window) new ResizeObserver(measure).observe(wrap);
window.addEventListener('resize', measure, {passive:true});
/* Deck pose. One segment per deal; the last card is never dealt away. */
function deckPose(i, p, out){
var active = Math.min(Math.floor(p / segment), total - 1);
var segP = clamp((p - active * segment) / segment, 0, 1);
if (i < active){ out.y=-250; out.rx=35; out.sc=1; out.t=1; return active; }
if (i === active){
out.y = lerp(-50,-200,segP); out.rx = lerp(0,35,segP); out.sc = 1; out.t = segP;
return active;
}
var behind = i - active;
out.y = -50 + (behind - segP) * Y_OFFSET;
out.rx = 0;
out.sc = 1 - (behind - segP) * SCALE_STEP;
out.t = 0;
return active;
}
var pose = {y:0, rx:0, sc:1, t:0};
function render(p, elapsed){
var active = 0;
cards.forEach(function(card, i){
active = deckPose(i, p, pose);
var e = elapsed >= introTotal ? 1 : easeOutExpo((elapsed - i * STAGGER_MS) / CARD_MS);
var y  = lerp(ENTER_Y, pose.y, e);
var rx = lerp(ENTER_RX, pose.rx, e);
var sc = lerp(ENTER_SCALE, pose.sc, e);
card.style.opacity = clamp(e * 1.6, 0, 1).toFixed(3);
card.style.transform =
'translate(-50%, ' + y.toFixed(2) + '%) rotateX(' + rx.toFixed(2) +
'deg) scale(' + sc.toFixed(3) + ')';
var t = pose.t * e;
copies[i].style.transform = 'translate3d(0,' + (t * -PARALLAX).toFixed(2) + '%,0)';
medias[i].style.transform = 'translate3d(0,' + (t * PARALLAX).toFixed(2) + '%,0) scale(' + (1 - t * 0.05).toFixed(3) + ')';
});
return active;
}
/* Category dots */
var dots = cards.map(function(card, i){
var b = document.createElement('button');
b.type = 'button';
b.className = 'stk-dot';
b.title = card.dataset.category;
b.setAttribute('aria-label', 'Jump to ' + card.dataset.category);
b.addEventListener('click', function(){ goToCard(i); });
dotsNav.appendChild(b);
return b;
});
function updateHud(p, active){
if (active !== activeIndex){
activeIndex = active;
cur.textContent = pad(active + 1);
dots.forEach(function(d, i){
if (i === active) d.setAttribute('aria-current','true');
else d.removeAttribute('aria-current');
});
cards.forEach(function(c, i){
c.setAttribute('aria-hidden', i === active ? 'false' : 'true');
c.tabIndex = i === active ? 0 : -1;
});
}
var atEnd = p >= .985;
cueLabel.textContent = atEnd ? 'Let’s build' : 'Scroll';
cue.setAttribute('aria-label', atEnd ? 'Continue to Let’s Build' : 'Scroll to next category');
if (!isCard){
cue.classList.toggle('hide', p > .02 && !atEnd);
}
}
function progressFromScroll(){
return clamp((window.scrollY - wrapTop) / span, 0, 1);
}
function goToCard(i){
var p = i >= total - 1 ? 1 : (i === 0 ? 0 : Math.min(1, i * segment + 0.002));
window.scrollTo({top: wrapTop + p * span, behavior: reduced ? 'auto' : 'smooth'});
}
function goToOutro(){
outro.scrollIntoView({behavior: reduced ? 'auto' : 'smooth', block:'start'});
}
cue.addEventListener('click', function(){
if (activeIndex >= total - 1) goToOutro();
else goToCard(activeIndex + 1);
});
/* Outro word-loading reveal, with reset when it leaves below the fold. */
function activateOutro(){ outro.classList.add('is-active'); }
function resetOutro(){ outro.classList.remove('is-active'); }
if (reduced || isCard){
activateOutro();
} else if ('IntersectionObserver' in window){
var io = new IntersectionObserver(function(entries){
entries.forEach(function(en){
if (en.isIntersecting) activateOutro();
else if (en.boundingClientRect.top > window.innerHeight) resetOutro();
});
}, {threshold:.25});
io.observe(outro);
} else {
activateOutro();
}
/* ── motion loop ──────────────────────────────────────────────────── */
if (reduced){
var staticRender = function(){
var p = isCard ? 0 : progressFromScroll();
var active = render(p, Infinity);
updateHud(p, active);
hud.classList.add('on');
cue.classList.add('on');
if (!isCard) cue.classList.toggle('hide', window.scrollY > 60 && p < .985);
};
staticRender();
if (!isCard) window.addEventListener('scroll', staticRender, {passive:true});
} else {
cards.forEach(function(c){ c.style.opacity = '0'; });
var tx = 0, ty = 0, sx = 0, sy = 0;
if (!isCard){
pin.addEventListener('pointermove', function(e){
if (e.pointerType === 'touch') return;
var r = pin.getBoundingClientRect();
tx = ((e.clientX - r.left) / r.width  - .5) * 2;
ty = ((e.clientY - r.top)  / r.height - .5) * 2;
});
pin.addEventListener('pointerleave', function(){ tx = 0; ty = 0; });
}
var introStart = performance.now();
var cardStart = performance.now();
var lastP = 0, vel = 0;
function loop(now){
var elapsed = now - introStart;
var p;
if (isCard){
var t = ((now - cardStart) % CARD_LOOP_MS) / CARD_LOOP_MS;
var revealEnd = CARD_REVEAL_MS / CARD_LOOP_MS;
p = t < revealEnd ? t / revealEnd : 1;
} else {
p = progressFromScroll();
}
vel = lerp(vel, clamp((p - lastP) * VEL_KICK, -VEL_MAX, VEL_MAX), 0.12);
lastP = p;
sx = lerp(sx, tx, 0.06);
sy = lerp(sy, ty, 0.06);
stage.style.transform =
'rotateX(' + (vel - sy * TILT_X).toFixed(2) + 'deg) rotateY(' + (sx * TILT_Y).toFixed(2) + 'deg)';
var active = render(p, elapsed);
updateHud(p, active);
if (elapsed >= introTotal){
hud.classList.add('on');
cue.classList.add('on');
}
raf = requestAnimationFrame(loop);
}
raf = requestAnimationFrame(loop);
}
/* ── start actions: cards + CTAs ──────────────────────────────────── */
var dialog = document.getElementById('start-dialog');
var formView = document.getElementById('dialog-form-view');
var successView = document.getElementById('dialog-success');
var form = document.getElementById('start-form');
var tabs = Array.prototype.slice.call(document.querySelectorAll('.dialog-tab'));
var nameField = document.getElementById('f-name');
var emailField = document.getElementById('f-email');
var roleField = document.getElementById('f-role');
var categoryField = document.getElementById('f-category');
var registerPanel = document.getElementById('panel-register');
var registerExtra = document.getElementById('panel-register-extra');
var loginPanel = document.getElementById('panel-login');
var errorEl = document.getElementById('dialog-error');
var submitBtn = document.getElementById('dialog-submit');
var titleEl = document.getElementById('dialog-title');
var descEl = document.getElementById('dialog-desc');
var mode = 'register';
var STORE_KEY = 'yekis-demo-profiles';
function readProfiles(){
try { return JSON.parse(localStorage.getItem(STORE_KEY) || '[]'); }
catch(e){ return []; }
}
function writeProfiles(list){
try { localStorage.setItem(STORE_KEY, JSON.stringify(list)); } catch(e){}
}
function setMode(next){
mode = next;
tabs.forEach(function(t){ t.setAttribute('aria-selected', String(t.dataset.mode === next)); });
