{
  "$comment": "Project-level DeepCode settings. A project file may only tighten what the user owns: it cannot grant full access, disable the command sandbox, or redirect model requests.",
  "$comment.2": "agents.defaults.microcompact, goal.completionVerifier and goal.maxRejections are ignored by the released 2.3.1 build and activate once a newer build ships them. They are kept here so the intent survives an upgrade.",
  "security": {
    "accessPreset": "ask",
    "permissions": {
      "bash": {
        "node scripts/scan-secrets.js": "allow",
        "node scripts/check-doc-parity.mjs": "allow",
        "pnpm --filter backend type-check*": "allow",
        "pnpm --filter backend route-audit:check*": "allow",
        "pnpm --filter backend lint*": "allow",
        "pnpm --filter backend test*": "allow",
        "pnpm --filter frontend lint*": "allow",
        "pnpm --filter frontend build*": "allow",
        "pnpm lint*": "allow",
        "pnpm build*": "allow",
        "pnpm test*": "allow",
        "git status*": "allow",
        "git diff*": "allow",
        "git log*": "allow",
        "git show*": "allow",
        "git branch*": "allow",
        "docker compose ps*": "allow",
        "docker compose logs*": "allow",
        "*prisma migrate reset*": "deny",
        "*prisma migrate dev*": "deny",
        "*prisma db push*": "deny",
        "*db:seed*": "deny",
        "*prisma db execute*": "deny",
        "*dropdb*": "deny",
        "*dropuser*": "deny",
        "*cleanup-dev-test-data*": "deny",
        "*purge-dev-audit-users*": "deny",
        "*docker compose down -v*": "deny",
        "*docker system prune*": "deny",
        "*git push*": "deny",
        "*git reset --hard*": "deny",
        "*git clean -fd*": "deny",
        "*rm -rf*": "deny",
        "*Remove-Item -Recurse*": "deny"
      },
      "write": {
        "*.env": "deny",
        "*.env.*": "deny",
        "*.pem": "deny",
        "*.key": "deny",
        "*credentials.json": "deny"
      },
      "edit": {
        "*.env": "deny",
        "*.env.*": "deny",
        "*.pem": "deny",
        "*.key": "deny",
        "*credentials.json": "deny"
      },
      "multi_edit": {
        "*.env": "deny",
        "*.env.*": "deny",
        "*.pem": "deny",
        "*.key": "deny",
        "*credentials.json": "deny"
      },
      "apply_patch": {
        "*.env": "deny",
        "*.env.*": "deny",
        "*.pem": "deny",
        "*.key": "deny",
        "*credentials.json": "deny"
      }
    }
  },
  "agents": {
    "defaults": {
      "connection": "nvidia-step",
      "model": "stepfun-ai/step-5-preview",
      "context_window_tokens": 131072,
      "max_tokens": 16384,
      "max_tool_iterations": 200,
      "microcompact": true
    }
  },
  "goal": {
    "completionVerifier": "rule",
    "maxRejections": 3
  }
}
