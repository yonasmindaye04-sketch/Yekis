{
  "name": "ethiopian-freelance-marketplace",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "vite apps/frontend --port=3000 --host=0.0.0.0",
    "dev:all": "docker compose up -d && pnpm -r --parallel dev",
    "dev:backend": "pnpm --filter backend dev",
    "dev:frontend": "pnpm --filter frontend dev",
    "tunnel:cloudflare": "powershell -ExecutionPolicy Bypass -File scripts/start-cloudflare-tunnel.ps1",
    "dev:tunnel": "node scripts/dev-with-tunnel.mjs",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down",
    "build": "npm --prefix apps/frontend run build",
    "build:all": "pnpm -r build",
    "lint": "npm --prefix apps/frontend run lint",
    "lint:all": "pnpm -r lint",
    "test": "pnpm -r test"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "pnpm@9.0.0",
  "dependencies": {
    "@blobatar/react": "^2.7.0",
    "blobatar": "^2.7.0",
    "framer-motion": "^14.0.0",
    "lucide-react": "^1.50.0",
    "ogl": "^1.0.11",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@babel/core": "^8.0.6",
    "@eslint/js": "^10.0.1",
    "@rolldown/plugin-babel": "^0.2.4",
    "@tailwindcss/vite": "^4.3.3",
    "@types/babel__core": "^7.20.5",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "tailwindcss": "^4.3.3",
    "ts-morph": "^28.0.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.2"
  },
  "workspaces": [
    "apps/frontend",
    "packages/*"
  ]
}
